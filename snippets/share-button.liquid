{% doc %}
  Renders Web Share with a copy-link fallback and accessible feedback.
  @param {string} share_link - Product path to share.
  @param {string} share_title - Title for the share dialog.
  @param {boolean} [icon_only] - Render a circular icon action.
{% enddoc %}
<share-button class="share-button{% if icon_only %} share-button--icon{% endif %}" data-share-url="{{ shop.url }}{{ share_link }}" data-share-title="{{ share_title | escape }}" data-copied-message="{{ 'general.share.success_message' | t | escape }}" data-error-message="{{ 'general.share.error_message' | t | escape }}">
  <button type="button" class="share-button__button{% if icon_only %} m3d-product-gallery__icon-button{% else %} button button--secondary{% endif %}" aria-label="{{ 'products.product.share' | t | escape }}" title="{{ 'products.product.share' | t | escape }}">
    {% render 'icon', name: 'm3d-share' %}{% unless icon_only %}{{ 'products.product.share' | t }}{% endunless %}
  </button>
  <span class="share-button__message" role="status" aria-live="polite" hidden></span>
</share-button>
{% javascript %}
  if (!customElements.get('share-button')) {
    customElements.define('share-button', class extends HTMLElement {
      connectedCallback() {
        if (this.controller) return;
        this.controller = new AbortController();
        this.button = this.querySelector('button');
        this.message = this.querySelector('.share-button__message');
        this.button.addEventListener('click', () => this.share(), { signal: this.controller.signal });
      }
      disconnectedCallback() {
        this.controller?.abort();
        this.controller = null;
        clearTimeout(this.messageTimer);
      }
      async share() {
        if (this.busy) return;
        this.busy = true;
        try {
          if (navigator.share) {
            try {
              await navigator.share({ url: this.dataset.shareUrl, title: this.dataset.shareTitle || document.title });
              return;
            } catch (error) {
              if (error.name === 'AbortError') return;
            }
          }
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(this.dataset.shareUrl);
          } else {
            const input = document.createElement('textarea');
            input.value = this.dataset.shareUrl;
            input.setAttribute('readonly', '');
            input.className = 'visually-hidden';
            this.append(input);
            input.select();
            const copied = document.execCommand('copy');
            input.remove();
            this.button.focus();
            if (!copied) throw new Error('COPY_FAILED');
          }
          this.showMessage(this.dataset.copiedMessage);
        } catch (error) {
          this.showMessage(this.dataset.errorMessage);
        } finally {
          this.busy = false;
        }
      }
      showMessage(text) {
        clearTimeout(this.messageTimer);
        this.message.hidden = false;
        this.message.textContent = text;
        this.messageTimer = setTimeout(() => { this.message.hidden = true; }, 4000);
      }
    });
  }
{% endjavascript %}
