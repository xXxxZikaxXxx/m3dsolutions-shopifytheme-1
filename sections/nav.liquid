ap:48px}.m3d-search-panel__links>p{margin:0 0 22px;color:#4436bc;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.09em}.m3d-search-panel__links ul{margin:0;padding:0;display:grid;gap:16px;list-style:none}.m3d-search-panel__links a{display:inline-flex;align-items:center;justify-content:space-between;gap:14px;min-height:30px;color:#000;font-size:13px;font-weight:700;text-transform:uppercase;transition:color 180ms ease}.m3d-search-panel__links a:hover,.m3d-search-panel__links a:focus-visible{color:#4436bc}.m3d-search-panel__links a span{font-size:17px;line-height:1}.m3d-search-panel__banners{display:flex;align-items:flex-start;gap:16px}.m3d-search-panel__banner{width:241px;display:flex;flex-direction:column;gap:12px;color:#000}.m3d-search-panel__visual{position:relative;width:241px;height:300px;display:block;overflow:hidden;background:#f3f3f3;transition:transform 220ms cubic-bezier(.22,1,.36,1),box-shadow 220ms ease}.m3d-search-panel__visual img{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:cover}.m3d-search-panel__visual small{position:absolute;z-index:1;left:16px;top:16px;padding:7px 10px;border-radius:999px;background:#fff;color:#000;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.m3d-search-panel__banner-link{display:flex;align-items:center;justify-content:space-between;min-height:26px;font-size:13px;font-weight:800;transition:color 180ms ease}.m3d-search-panel__banner-link span{transition:transform 180ms ease}.m3d-search-panel__banner:hover .m3d-search-panel__visual,.m3d-search-panel__banner:focus-visible .m3d-search-panel__visual{transform:translateY(-2px);box-shadow:0 12px 26px rgba(0,0,0,.16)}.m3d-search-panel__banner:hover .m3d-search-panel__banner-link,.m3d-search-panel__banner:focus-visible .m3d-search-panel__banner-link{color:#4436bc}.m3d-search-panel__banner:hover .m3d-search-panel__banner-link span,.m3d-search-panel__banner:focus-visible .m3d-search-panel__banner-link span{transform:translateX(4px)}.m3d-header__nav-shell{position:relative;min-height:66px;display:flex;align-items:center;border-top:1px solid #d9d9d9;border-bottom:1px solid #d9d9d9}.m3d-header__nav{width:100%;max-width:1288px;min-height:46px;margin:0 auto;padding:0 20px;display:flex;align-items:center;gap:2px;border:0;border-radius:0;font-size:14px}.m3d-header__nav>a,.m3d-header__collections>summary{position:relative;z-index:1;min-height:36px;padding:0 16px;display:flex;align-items:center;color:#fff;white-space:nowrap;mix-blend-mode:difference}.m3d-header__collections>summary{gap:7px;list-style:none;cursor:pointer}.m3d-header__collections>summary::-webkit-details-marker{display:none}.m3d-header__collections-arrow{display:inline-grid;place-items:center;width:14px;height:14px;font-size:20px;line-height:1;transform:rotate(0deg);transition:transform 420ms cubic-bezier(.22,1,.36,1)}.m3d-header__collections[open][data-expanded] .m3d-header__collections-arrow{transform:rotate(90deg)}.m3d-header__cursor{position:absolute;z-index:0;left:0;top:50%;width:0;height:36px;border-radius:999px;background:#000;opacity:0;pointer-events:none;transform:translate3d(0,-50%,0);transform-origin:center;will-change:transform,width;transition:opacity 180ms ease}.m3d-header__nav[data-m3d-ready] .m3d-header__cursor{opacity:1}.m3d-header__quote{font-weight:700}.m3d-mega{position:absolute;z-index:3;left:0;right:0;top:100%;padding:34px max(24px,calc((100vw - var(--page-width))/2 + 20px));display:grid;grid-template-columns:1fr 430px;gap:80px;background:#fff;border-top:1px solid #e7e7e7;box-shadow:0 24px 48px rgba(0,0,0,.16);opacity:0;visibility:hidden;pointer-events:none;clip-path:inset(0 0 100% 0);transform:translateY(-12px);transform-origin:top center;transition:clip-path 460ms cubic-bezier(.22,1,.36,1),transform 460ms cubic-bezier(.22,1,.36,1),opacity 260ms ease,visibility 0s linear 460ms}.m3d-header__collections[open][data-expanded] .m3d-mega{opacity:1;visibility:visible;pointer-events:auto;clip-path:inset(0);transform:translateY(0);transition-delay:0s}.m3d-mega__category{position:relative}.m3d-mega__category>p{margin-bottom:16px;color:#4436bc;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.m3d-mega__category ul{display:grid;grid-template-columns:repeat(2,minmax(160px,1fr));gap:12px 40px;margin:0;padding:0 0 0 14px;list-style:none}.m3d-mega__category li{min-width:0}.m3d-mega__category li a{min-height:28px;display:inline-flex;align-items:center;color:#000;transition:color 180ms ease}.m3d-mega__category li a:hover,.m3d-mega__category li a:focus-visible{color:#4436bc}.m3d-mega__hover-line{position:absolute;z-index:1;left:0;top:0;color:#4436bc;font-size:18px;font-weight:800;line-height:1;opacity:0;pointer-events:none;transform:translate3d(0,0,0);transition:transform 230ms cubic-bezier(.22,1,.36,1),opacity 160ms ease;will-change:transform,opacity}.m3d-mega__category[data-hovering] .m3d-mega__hover-line{opacity:1}.m3d-mega a{color:#000}.m3d-mega__feature{min-height:190px;display:grid;grid-template-columns:1fr 1fr;overflow:hidden;background:#f0edff}.m3d-mega__feature>div{padding:24px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:12px}.m3d-mega__feature strong{font-size:24px;line-height:1.05}.m3d-mega__feature b{padding:11px 14px;background:#4436bc;color:#fff;font-size:12px}.m3d-mega__feature img{width:100%;height:100%;object-fit:cover}.m3d-header__toggle,.m3d-mobile-nav{display:none}.m3d-header__toggle{flex-direction:column;gap:4px;background:transparent}.m3d-header__toggle span{width:20px;height:2px;background:#000}
