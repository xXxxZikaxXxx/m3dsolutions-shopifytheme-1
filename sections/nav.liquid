<script>
  document.querySelectorAll('[data-m3d-toggle]').forEach(function(toggle){if(toggle.dataset.bound==='true')return;toggle.dataset.bound='true';toggle.addEventListener('click',function(){var nav=document.getElementById(toggle.getAttribute('aria-controls'));if(!nav)return;var open=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!open));nav.hidden=open;});});
  document.querySelectorAll('[data-m3d-slide-tabs]').forEach(function(nav){
    if(nav.dataset.slideTabsBound==='true')return;
    nav.dataset.slideTabsBound='true';
    var shell=nav.parentElement;
    var header=nav.closest('.m3d-header');
    var cursor=nav.querySelector('[data-m3d-cursor]');
    var details=nav.querySelector('.m3d-header__collections');
    var summary=details.querySelector('summary');
    var tabs=Array.prototype.slice.call(nav.querySelectorAll('[data-m3d-tab]'));
    var selected=0;
    var closeTimer;
    var navigationTimer;
    var searchForm=header.querySelector('[data-m3d-search-form]');
    var searchInput=header.querySelector('[data-m3d-search-input]');
    var searchClose=header.querySelector('[data-m3d-search-close]');
    var searchPanel=header.querySelector('[data-m3d-search-panel]');
    var megaCategory=details.querySelector('[data-m3d-mega-category]');
    var megaHoverLine=details.querySelector('[data-m3d-mega-hover-line]');
    var megaCategoryLinks=Array.prototype.slice.call(megaCategory.querySelectorAll('li a'));
    var megaHoverFrame;
    var motion={x:0,width:0,startX:0,startWidth:0,targetX:0,targetWidth:0,startTime:0,duration:380,frame:0,ready:false};

    try{
      var storedSelected=Number(window.sessionStorage.getItem('m3d-selected-tab'));
      if(Number.isInteger(storedSelected)&&storedSelected>=0&&storedSelected<tabs.length)selected=storedSelected;
    }catch(error){}

    function renderCursor(){
      cursor.style.width=motion.width+'px';
      cursor.style.transform='translate3d('+motion.x+'px,-50%,0)';
    }

    function animateCursor(timestamp){
      if(!motion.startTime)motion.startTime=timestamp;
      var progress=Math.min((timestamp-motion.startTime)/motion.duration,1);
      var eased=1-Math.pow(1-progress,4);
      motion.x=motion.startX+(motion.targetX-motion.startX)*eased;
      motion.width=motion.startWidth+(motion.targetWidth-motion.startWidth)*eased;
      renderCursor();
      if(progress>=1){
        motion.x=motion.targetX;
        motion.width=motion.targetWidth;
        motion.startTime=0;
        motion.frame=0;
        renderCursor();
        return;
      }
      motion.frame=window.requestAnimationFrame(animateCursor);
    }

    function moveCursor(tab,immediate){
      if(!tab||nav.offsetParent===null)return;
      var tabRect=tab.getBoundingClientRect();
      var shellRect=shell.getBoundingClientRect();
      var nextX=tabRect.left-shellRect.left;
      var distance=Math.abs(nextX-motion.x);
      motion.targetX=nextX;
      motion.targetWidth=tabRect.width;
      if(!motion.ready||immediate){
        if(motion.frame)window.cancelAnimationFrame(motion.frame);
        motion.x=motion.targetX;
        motion.width=motion.targetWidth;
        motion.startX=motion.x;
        motion.startWidth=motion.width;
        motion.startTime=0;
        motion.frame=0;
        motion.ready=true;
        renderCursor();
        nav.setAttribute('data-m3d-ready','');
        return;
      }
      if(motion.frame)window.cancelAnimationFrame(motion.frame);
      motion.startX=motion.x;
      motion.startWidth=motion.width;
      motion.startTime=0;
      motion.duration=Math.min(440,Math.max(300,300+distance*.12));
      motion.frame=window.requestAnimationFrame(animateCursor);
    }

    function openCollections(){
      closeSearch();
      window.clearTimeout(closeTimer);
      details.open=true;
      selected=0;
      moveCursor(summary,false);
      header.style.setProperty('--m3d-overlay-top',Math.max(0,header.getBoundingClientRect().bottom)+'px');
      window.requestAnimationFrame(function(){
        details.setAttribute('data-expanded','');
        header.setAttribute('data-collections-open','');
      });
    }

    function closeCollections(){
      if(!details.open)return;
      clearMegaHoverLine();
      details.removeAttribute('data-expanded');
      header.removeAttribute('data-collections-open');
      closeTimer=window.setTimeout(function(){details.open=false;},470);
    }

    function moveMegaHoverLine(link){
      window.cancelAnimationFrame(megaHoverFrame);
      megaHoverFrame=window.requestAnimationFrame(function(){
        if(!details.open)return;
        var categoryRect=megaCategory.getBoundingClientRect();
        var linkRect=link.getBoundingClientRect();
        var x=linkRect.left-categoryRect.left-12;
        var y=linkRect.top-categoryRect.top+(linkRect.height-megaHoverLine.offsetHeight)/2;
        var nextTransform='translate3d('+x+'px,'+y+'px,0)';
        if(!megaCategory.hasAttribute('data-hovering')){
          megaHoverLine.style.transition='none';
          megaHoverLine.style.transform=nextTransform;
          megaHoverLine.offsetWidth;
          megaHoverLine.style.removeProperty('transition');
        }else{
          megaHoverLine.style.transform=nextTransform;
        }
        megaCategory.setAttribute('data-hovering','');
      });
    }

    function clearMegaHoverLine(){
      window.cancelAnimationFrame(megaHoverFrame);
      megaCategory.removeAttribute('data-hovering');
    }

    function openSearch(){
      if(header.hasAttribute('data-search-open'))return;
      if(details.open)closeCollections();
      header.setAttribute('data-search-open','');
      searchPanel.setAttribute('aria-hidden','false');
      header.style.setProperty('--m3d-overlay-top',Math.max(0,searchPanel.getBoundingClientRect().bottom)+'px');
    }

    function closeSearch(){
      if(!header.hasAttribute('data-search-open'))return;
      header.removeAttribute('data-search-open');
      searchPanel.setAttribute('aria-hidden','true');
    }

    searchInput.addEventListener('click',openSearch);
    searchForm.addEventListener('submit',function(event){
      if(!header.hasAttribute('data-search-open')&&!searchInput.value.trim()){
        event.preventDefault();
        openSearch();
        searchInput.focus();
      }
    });
    searchClose.addEventListener('click',function(){
      closeSearch();
      searchInput.blur();
    });

    megaCategoryLinks.forEach(function(link){
      link.addEventListener('pointerenter',function(){moveMegaHoverLine(link);});
      link.addEventListener('focus',function(){moveMegaHoverLine(link);});
    });
    megaCategory.addEventListener('pointerleave',clearMegaHoverLine);
    megaCategory.addEventListener('focusout',function(event){
      if(!megaCategory.contains(event.relatedTarget))clearMegaHoverLine();
    });

    summary.addEventListener('click',function(event){
      event.preventDefault();
      if(details.open&&details.hasAttribute('data-expanded'))closeCollections();else openCollections();
    });

    tabs.forEach(function(tab,index){
      tab.addEventListener('click',function(event){
        if(tab.tagName==='A'&&(event.button!==0||event.metaKey||event.ctrlKey||event.shiftKey||event.altKey||tab.target==='_blank'))return;
        selected=index;
        try{window.sessionStorage.setItem('m3d-selected-tab',String(index));}catch(error){}
        moveCursor(tab,false);
        if(tab.tagName!=='A')return;
        event.preventDefault();
        window.clearTimeout(navigationTimer);
        navigationTimer=window.setTimeout(function(){window.location.assign(tab.href);},520);
      });
    });

    document.addEventListener('keydown',function(event){
      if(event.key!=='Escape')return;
      if(header.hasAttribute('data-search-open')){
        closeSearch();
        searchInput.blur();
        return;
      }
      if(details.open){closeCollections();summary.focus();}
    });
    document.addEventListener('click',function(event){
      if(details.open&&!header.contains(event.target))closeCollections();
      if(header.hasAttribute('data-search-open')&&!header.contains(event.target))closeSearch();
    });
    header.addEventListener('click',function(event){
      if(event.target!==header)return;
      if(details.open)closeCollections();
      if(header.hasAttribute('data-search-open'))closeSearch();
    });

    var observer=new ResizeObserver(function(){moveCursor(tabs[selected],true);});
    observer.observe(nav);
    if(document.fonts&&document.fonts.ready){document.fonts.ready.then(function(){moveCursor(tabs[selected],true);});}else{moveCursor(tabs[selected],true);}
  });
</script>

