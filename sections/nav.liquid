{%- liquid
  assign products_url = section.settings.products_url | default: routes.all_products_collection_url
  assign vestuario_url = section.settings.vestuario_url | default: routes.all_products_collection_url
  assign myshop_url = section.settings.myshop_url | default: routes.account_url
  assign inspiration_url = section.settings.inspiration_url | default: routes.root_url
  assign about_url = section.settings.about_url | default: routes.root_url
  assign quote_url = section.settings.quote_url | default: routes.root_url
  assign delivery_url = section.settings.delivery_url | default: routes.root_url
  assign personalization_url = section.settings.personalization_url | default: routes.root_url
  assign catalogs_url = section.settings.catalogs_url | default: routes.all_products_collection_url
  assign category_handles = 'campanhas-sazonais,casa-e-bem-estar,copos-e-garrafas,escritorio-e-escrita,eventos-e-feiras,ideias-para-o-dia-a-dia,kits-de-boas-vindas,malas-e-viagens,presentes-para-equipas,tecnologia,vesturio-e-acessrios' | split: ','
-%}

<div class="m3d-benefits">
  <div class="page-width m3d-benefits__inner">
    <span>{{ section.settings.benefit_one | escape }}</span>
    <span>{{ section.settings.benefit_two | escape }}</span>
    <span>{{ section.settings.benefit_three | escape }}</span>
  </div>
</div>

<header class="m3d-header" data-section-id="{{ section.id }}">
  <div class="page-width m3d-header__main">
    <button class="m3d-header__toggle tap-target" type="button" aria-label="{{ 'sections.header.menu' | t }}" aria-expanded="false" aria-controls="M3dNav-{{ section.id }}" data-m3d-toggle>
      <span></span><span></span><span></span>
    </button>

    <a class="m3d-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 480 | image_tag: class: 'm3d-header__logo-configured', widths: '120, 240, 360, 480', width: 120, alt: shop.name }}
      {%- else -%}
        <img src="{{ 'm3dsolutionslogo.png' | asset_url }}" width="3375" height="4219" alt="{{ shop.name | escape }}">
      {%- endif -%}
    </a>

    <form class="m3d-header__search" action="{{ routes.search_url }}" method="get" role="search" data-m3d-search-form>
      <div class="m3d-header__search-field">
        <label class="visually-hidden" for="M3dSearch-{{ section.id }}">{{ 'general.search.search' | t }}</label>
        <input id="M3dSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder | escape }}" data-m3d-search-input>
        <button type="submit" aria-label="{{ 'general.search.submit' | t }}">{% render 'icon', name: 'search' %}</button>
      </div>
      <button class="m3d-header__search-cancel" type="button" data-m3d-search-close>Cancelar</button>
    </form>

    <div class="m3d-header__actions">
      <a class="m3d-header__account" href="{{ routes.account_url }}">{{ section.settings.account_label | escape }}</a>
      <a class="m3d-header__cart tap-target" href="{{ routes.cart_url }}" aria-label="{{ 'templates.cart.cart' | t }}">
        {% render 'icon', name: 'cart' %}
        <span data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <nav class="m3d-search-panel" aria-label="Pesquisa e destaques" aria-hidden="true" data-m3d-search-panel>
    <div class="page-width m3d-search-panel__inner">
      <div class="m3d-search-panel__links">
        <p>Saiba mais sobre</p>
        <ul role="list">
          <li><a href="{{ delivery_url }}">Prazos de entrega <span aria-hidden="true">↗</span></a></li>
          <li><a href="{{ personalization_url }}">Personalizações &amp; impressão <span aria-hidden="true">↗</span></a></li>
          <li><a href="{{ catalogs_url }}">Catálogos <span aria-hidden="true">↗</span></a></li>
          <li><a href="{{ myshop_url }}">MyShop <span aria-hidden="true">↗</span></a></li>
        </ul>
      </div>
      <div class="m3d-search-panel__banners" aria-label="Destaques temporários">
        <a class="m3d-search-panel__banner" href="{{ products_url }}">
          <span class="m3d-search-panel__visual"><img src="{{ 'navbar-search-banner-1-m03214.png' | asset_url }}" width="753" height="938" alt="Mochila preta M03214"><small>Novidade</small></span>
          <span class="m3d-search-panel__banner-link">Ir para produto <span aria-hidden="true">→</span></span>
        </a>
        <a class="m3d-search-panel__banner" href="{{ products_url }}">
          <span class="m3d-search-panel__visual"><img src="{{ 'navbar-search-banner-2-sg1036.png' | asset_url }}" width="753" height="938" alt="Camisola de Natal SG1036"><small>Ideia M3D</small></span>
          <span class="m3d-search-panel__banner-link">Ir para produto <span aria-hidden="true">→</span></span>
        </a>
        <a class="m3d-search-panel__banner" href="{{ products_url }}">
          <span class="m3d-search-panel__visual"><img src="{{ 'navbar-search-banner-3-so4447.png' | asset_url }}" width="753" height="938" alt="Casaco azul SO4447"><small>Em destaque</small></span>
          <span class="m3d-search-panel__banner-link">Ir para produto <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </nav>

  <div class="m3d-header__nav-shell">
    <nav class="page-width m3d-header__nav" aria-label="{{ 'sections.header.menu' | t }}" data-m3d-slide-tabs>
      <span class="m3d-header__cursor" aria-hidden="true" data-m3d-cursor></span>
      <details class="m3d-header__collections">
        <summary data-m3d-tab>{{ section.settings.collections_label | escape }} <span class="m3d-header__collections-arrow" aria-hidden="true">›</span></summary>
        <div class="m3d-mega">
          <div class="m3d-mega__category" data-m3d-mega-category>
            <p>{{ section.settings.category_heading | escape }}</p>
            <span class="m3d-mega__hover-line" aria-hidden="true" data-m3d-mega-hover-line>|</span>
            <ul role="list">
              {%- for category_handle in category_handles -%}
                {%- assign category_page = pages[category_handle] -%}
                {%- if category_page != blank -%}
                  <li><a href="{{ category_page.url }}">{{ category_page.title | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
          <a class="m3d-mega__feature" href="{{ vestuario_url }}">
            <div><span>Vestuário e têxteis</span><strong>A sua marca veste o verão.</strong><b>Explorar vestuário →</b></div>
            <img src="{{ 'vestuario.png' | asset_url }}" width="4300" height="2400" alt="">
          </a>
        </div>
      </details>
      <a href="{{ products_url }}" data-m3d-tab>{{ section.settings.products_label | escape }}</a>
      <a href="{{ vestuario_url }}" data-m3d-tab>{{ section.settings.vestuario_label | escape }}</a>
      <a href="{{ myshop_url }}" data-m3d-tab>MyShop</a>
      <a href="{{ inspiration_url }}" data-m3d-tab>{{ section.settings.inspiration_label | escape }}</a>
      <a href="{{ about_url }}" data-m3d-tab>{{ section.settings.about_label | escape }}</a>
      <a class="m3d-header__quote" href="{{ quote_url }}" data-m3d-tab>{{ section.settings.quote_label | escape }} →</a>
    </nav>
  </div>

  <div class="m3d-mobile-nav" id="M3dNav-{{ section.id }}" hidden>
    <form action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="M3dMobileSearch-{{ section.id }}">{{ 'general.search.search' | t }}</label>
      <input id="M3dMobileSearch-{{ section.id }}" type="search" name="q" placeholder="{{ section.settings.search_placeholder | escape }}">
      <button type="submit" aria-label="{{ 'general.search.submit' | t }}">{% render 'icon', name: 'search' %}</button>
    </form>
    <nav aria-label="{{ 'sections.header.menu' | t }}">
      <a href="{{ products_url }}">{{ section.settings.products_label | escape }} →</a>
      <a href="{{ vestuario_url }}">{{ section.settings.vestuario_label | escape }} →</a>
      <a href="{{ myshop_url }}">MyShop →</a>
      <a href="{{ inspiration_url }}">{{ section.settings.inspiration_label | escape }} →</a>
      <a href="{{ about_url }}">{{ section.settings.about_label | escape }} →</a>
    </nav>
  </div>
</header>

<style>
  .m3d-benefits{background:#000;color:#fff;font-size:11px}.m3d-benefits__inner{min-height:30px;display:flex;align-items:center;justify-content:center;gap:72px}.m3d-header{--m3d-overlay-top:0px;position:relative;z-index:30;background:#fff;color:#000}.m3d-header::after{content:"";position:fixed;z-index:1;left:0;right:0;top:var(--m3d-overlay-top);bottom:0;background:rgba(0,0,0,.28);backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px);opacity:0;visibility:hidden;pointer-events:none;transition:opacity 320ms ease,visibility 0s linear 320ms}.m3d-header[data-collections-open]::after,.m3d-header[data-search-open]::after{opacity:1;visibility:visible;pointer-events:auto;transition-delay:0s}.m3d-header__main{position:relative;z-index:5;max-width:1288px;min-height:82px;display:grid;grid-template-columns:150px minmax(280px,1fr) auto;align-items:center;gap:48px}.m3d-header__logo{position:relative;display:block;width:120px;height:58px;overflow:hidden}.m3d-header__logo img{position:absolute;left:50%;top:50%;width:120px;height:auto;transform:translate(-50%,-50%);display:block}.m3d-header__logo .m3d-header__logo-configured{position:static;width:auto;max-width:120px;max-height:58px;transform:none}.m3d-header__search{position:absolute;right:244px;top:50%;width:260px;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:0;transform:translateY(-50%);transition:right 420ms cubic-bezier(.22,1,.36,1),width 420ms cubic-bezier(.22,1,.36,1)}.m3d-header__search-field{height:44px;display:grid;grid-template-columns:minmax(0,1fr) 44px;background:#f5f5f7;border:1px solid #d9d9d9;box-shadow:none}.m3d-header__search-field:focus-within{box-shadow:inset 0 -2px #000}.m3d-header__search input{width:100%;min-width:0;padding:0 16px;background:transparent}.m3d-header__search input:focus-visible{outline:none}.m3d-header__search button,.m3d-mobile-nav form button{display:grid;place-items:center;background:transparent}.m3d-header__search-cancel{max-width:0;min-height:44px;padding:0