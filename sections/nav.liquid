  @media(max-width:1000px){.m3d-benefits__inner{min-height:26px}.m3d-benefits__inner span:not(:first-child){display:none}.m3d-header__main{min-height:72px;grid-template-columns:44px 1fr 44px;gap:8px;padding:0 12px}.m3d-header__toggle{display:inline-flex}.m3d-header__logo{justify-self:center;width:120px;height:56px}.m3d-header__search,.m3d-search-panel,.m3d-header__account,.m3d-header__nav-shell{display:none}.m3d-header__actions{justify-content:flex-end}.m3d-mobile-nav{display:block;padding:16px 20px 28px;border-top:1px solid #ededed}.m3d-mobile-nav[hidden]{display:none}.m3d-mobile-nav form{height:44px;display:grid;grid-template-columns:1fr 44px;background:#f5f5f7}.m3d-mobile-nav form input{min-width:0;padding:0 14px;background:transparent}.m3d-mobile-nav nav{margin-top:14px;display:grid}.m3d-mobile-nav nav a{min-height:48px;display:flex;align-items:center;border-bottom:1px solid #ededed;color:#000;font-weight:700}}
