{%- comment -%}
  ============================================================
  MAIN CART — página nativa do carrinho
  ============================================================

  O QUE FAZ:
  Exibe o carrinho completo: lista de itens (imagem, opções de
  variante, propriedades de linha, descontos, preço unitário),
  seletor de quantidade, remoção de item e o resumo com subtotal,
  nota do pedido e botões de atualizar/finalizar compra.

  ONDE É USADA:
  No template do carrinho (templates/cart.json), como section
  principal da página /cart.

  PRINCIPAIS PARTES:
  - Estado vazio (cart--empty) com link para continuar comprando
    quando cart.item_count == 0.
  - {% form 'cart' %}: tabela cart-items percorrendo cart.items;
    funciona 100% sem JavaScript (o submit do form é o fallback).
  - Resumo (cart__summary): nota do pedido (setting show_note),
    descontos de nível de carrinho, subtotal, aviso de impostos/
    frete e botões update/checkout + checkouts adicionais.
  - <script> de progressive enhancement: intercepta os botões +/-
    e o change do input, chamando /cart/change.js e recarregando
    a página. Se o JS falhar, o form nativo ainda funciona.

  OBSERVAÇÕES:
  - Os estilos ficam inline no

<style> no topo do arquivo, usando
    as variáveis CSS do tema (--color-*, --f*, etc.).
  - Setting show_note controla a exibição do campo de observação.
  - Após alterar quantidade via JS a página é recarregada
    (refresh) — não há atualização parcial do DOM.
{%- endcomment -%}
{%- liquid
  assign cart_has_quote = false
  for cart_item in cart.items
    if cart_item.variant.price == 0 and cart_item.original_price == 0
      assign cart_has_quote = true
    endif
  endfor
  assign cart_quote_page = pages['pedir-orcamento']
  assign cart_quote_url = cart_quote_page.url
  if cart_quote_url != blank
    assign cart_quote_url = cart_quote_url | append: '?view=m3d-quote'
  endif
-%}
<style>
  #shopify-section-{{ section.id }} .cart {
    padding-top: var(--spacing-sections);
    padding-bottom: var(--spacing-sections);
  }
  .cart__title {
    font-size: var(--m3d-text-3xl, 1.75rem);
    margin-bottom: 32px;
  }

  /* Empty state */
  .cart--empty {
    width: min(720px, 100%);
    margin: 0 auto;
    padding: 56px 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
    border-radius: 16px;
    background: var(--m3d-color-surface-alt, #f5f5f7);
  }
  .cart__empty-heading {
    margin: 0;
    color: var(--m3d-color-text, #000000);
    font-size: 28px;
    line-height: 1.35;
  }
  .cart__empty-text {
    max-width: 520px;
    margin: 0 0 8px;
    color: var(--m3d-color-text-muted, #606060);
    font-size: 16px;
    line-height: 1.45;
  }
  .cart__empty-action {
    min-width: 220px;
  }

  /* Layout */
  .cart__contents {
    display: flex;
    align-items: flex-start;
    gap: 48px;
  }
  .cart__items { flex: 1 1 auto; min-width: 0; }
  .cart__summary {
    flex: 0 0 320px;
    position: sticky;
    top: 24px;
  }

  /* Table */
  .cart-items {
    width: 100%;
    border-collapse: collapse;
  }
  .cart-items th {
    text-align: left;
    font-size: var(--m3d-text-sm, 0.875rem);
    font-weight: var(--m3d-weight-bold, 700);
    color: var(--m3d-color-text-muted, #606060);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--m3d-color-border, #d9d9d9);
  }
  .cart-items th.cart-items__heading--right { text-align: right; }
  .cart-item {
    border-bottom: 1px solid var(--m3d-color-border, #d9d9d9);
  }
  .cart-item > td { padding: 24px 0; vertical-align: top; }

  .cart-item__media { width: 100px; padding-inline-end: 20px; }
  .cart-item__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--m3d-radius-media, 12px);
    background-color: var(--m3d-color-surface-alt, #f5f5f7);
  }

  .cart-item__details { line-height: 1.5; }
  .cart-item__name {
    font-size: var(--m3d-text-lg, 1.125rem);
    color: var(--m3d-color-text, #000000);
    text-decoration: none;
    font-family: var(--m3d-font-family, var(--font-body-family));
  }
  .cart-item__name:hover { text-decoration: underline; }
  .cart-item__options,
  .cart-item__property {
    font-size: var(--m3d-text-sm, 0.875rem);
    color: var(--m3d-color-text-muted, #606060);
    margin-top: 4px;
  }
  .cart-item__logo { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; text-decoration: underline; }
  .cart-item__logo img { width: 40px; height: 40px; object-fit: contain; border-radius: var(--m3d-radius-field); }
  .cart-item__discounts {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    font-size: var(--m3d-text-sm, 0.875rem);
    color: var(--m3d-color-text, #000000);
  }
  .cart-item__unit-price {
    font-size: var(--m3d-text-sm, 0.875rem);
    color: var(--m3d-color-text-muted, #606060);
    margin-top: 6px;
  }

  .cart-item__price { min-width: 96px; padding-inline-start: 16px; text-align: end; white-space: nowrap; }
  .cart-item__price s { opacity: 0.6; margin-right: 6px; }
  .cart-item__price .cart-item__discounted { color: var(--m3d-color-text, #000000); }

  .cart-item__quantity-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  .cart-items .quantity-selector {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--m3d-color-border-control, #8a8a8a);
    border-radius: var(--m3d-radius-field, 8px);
    overflow: hidden;
  }
  .cart-items .quantity__button {
    width: 44px; height: 44px;
    display: inline-grid; place-items: center; padding: 0;
    background: none; border: none; cursor: pointer;
    font-size: var(--m3d-text-lg, 1.125rem); color: var(--m3d-color-text, #000000);
  }
  .cart-items .quantity__input {
    width: 48px; height: 44px;
    text-align: center; border: none;
    background: transparent; color: var(--m3d-color-text, #000000);
    -moz-appearance: textfield;
    font-size: var(--m3d-text-md, 1rem);
  }
  .cart-items .quantity__input::-webkit-outer-spin-button,
  .cart-items .quantity__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .cart-item__remove {
    background: none;
    border: none;
    padding: 0;
    font-size: var(--m3d-text-sm, 0.875rem);
    color: var(--m3d-color-text, #000000);
    color: var(--m3d-color-text-muted, #606060);
    text-decoration: underline;
    cursor: pointer;
  }
  .cart-item__remove:hover { opacity: 1; }

  /* Summary */
  .cart__note-label {
    display: block;
    font-size: var(--m3d-text-sm, 0.875rem);
    margin-bottom: 8px;
  }
  .cart__note {
    width: 100%;
    resize: vertical;
    margin-bottom: 24px;
  }
  .cart__discounts {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
    font-size: var(--m3d-text-sm, 0.875rem);
    color: var(--m3d-color-text, #000000);
  }
  .cart__subtotal {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: var(--m3d-text-xl, 1.25rem);
    margin-bottom: 8px;
  }
  .cart__tax-note {
    font-size: var(--m3d-text-sm, 0.875rem);
    color: var(--m3d-color-text-muted, #606060);
    margin-bottom: 20px;
  }
  .cart__tax-note a { color: inherit; }
  .cart__checkout { width: 100%; }
  .cart__update {
    width: 100%;
    margin-bottom: 12px;
  }
  .cart__additional-checkout {
    margin-top: 12px;
    display: grid;
    gap: 8px;
  }

  @media screen and (max-width: 1000px) {
    .cart__contents { flex-direction: column; gap: 32px; }
    .cart__summary { position: static; flex-basis: auto; width: 100%; }
    .cart-item__media { width: 84px; padding-inline-end: 14px; }
    .cart-items thead { display: none; }
  }
  @media screen and (max-width: 749px) {
    .cart--empty { padding: 40px 24px; }
    .cart__empty-heading { font-size: 24px; }
    .cart__empty-action { width: 100%; min-width: 0; }
  }

  .section-main-cart { color: var(--m3d-color-text, #000000); }
  .cart__title, .cart__empty-heading, .cart-item__name { font-weight: var(--m3d-weight-bold, 700); }
  .cart-item__details, .cart-item__price { overflow-wrap: anywhere; }
  .cart-item__name { font-size: var(--m3d-text-md, 1rem); }
  .cart-item__price, .cart__subtotal, .quantity__input { font-variant-numeric: var(--m3d-numeric, lining-nums tabular-nums); }
  .cart-item__price { font-weight: var(--m3d-weight-regular, 400); }
  .quantity__input { font-family: var(--m3d-font-numeric, ui-sans-serif, system-ui); font-variant-numeric: lining-nums tabular-nums; }
  .cart-item__consultation { white-space: normal; }
  .cart-item__remove { display: inline-flex; align-items: center; min-height: 44px; }
  .cart__note {
    padding: var(--m3d-space-3, 0.75rem) var(--m3d-space-4, 1rem);
    border: 1px solid var(--m3d-color-border-control, #8a8a8a);
    border-radius: var(--m3d-radius-field, 8px);
    font: inherit; font-size: var(--m3d-text-md, 1rem);
    color: var(--m3d-color-text, #000000); background: var(--m3d-color-surface, #ffffff);
  }
  .cart__checkout, .cart__update, .cart__empty-action, .cart__quote-action {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 48px; padding: var(--m3d-space-3, 0.75rem) var(--m3d-space-6, 1.5rem);
    border: 1px solid transparent; border-radius: var(--m3d-radius-pill, 999px);
    font-size: var(--m3d-text-md, 1rem); font-weight: var(--m3d-weight-bold, 700);
    line-height: 1.4; text-align: center; text-decoration: none;
    color: var(--m3d-color-action-primary-text, #ffffff); background: var(--m3d-color-action-primary, #4436bc);
  }
  .section-main-cart .cart__update { border-color: var(--m3d-color-text, #000000); color: var(--m3d-color-text, #000000); background: var(--m3d-color-surface, #ffffff); }
  .cart__checkout:disabled { opacity: 1; color: var(--m3d-color-text-muted, #606060); background: var(--m3d-gray-100, #e5e5e5); cursor: not-allowed; }
  .cart__quote-notice { margin-bottom: var(--m3d-space-6, 1.5rem); padding: var(--m3d-space-4, 1rem); background: var(--m3d-color-surface-alt, #f5f5f7); border-radius: var(--m3d-radius-field, 8px); }
  .cart__quote-notice p { margin: 0 0 var(--m3d-space-4, 1rem); font-size: var(--m3d-text-md, 1rem); line-height: var(--m3d-leading-body, 1.55); }
  .cart__partial-note { margin: 0 0 var(--m3d-space-4, 1rem); font-size: var(--m3d-text-sm, 0.875rem); line-height: var(--m3d-leading-body, 1.55); color: var(--m3d-color-text-muted, #606060); }
  .section-main-cart [hidden] { display: none; }
  .section-main-cart :focus-visible { outline: 2px solid var(--m3d-focus-color, #4436bc); outline-offset: 3px; }
  @media screen and (max-width: 749px) {
    .cart-item { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 12px 16px; padding-block: 24px; }
    .cart-item > td { padding: 0; min-width: 0; }
    .cart-item__media { grid-row: 1 / span 3; width: auto; padding-inline-end: 0; }
    .cart-item__details, .cart-item__quantity, .cart-item__price { grid-column: 2; }
    .cart-item__quantity-wrapper { align-items: flex-start; }
    .cart-item__price { min-width: 0; padding-inline-start: 0; text-align: end; }
  }
  @media (forced-colors: active) {
    .section-main-cart :focus-visible { outline-color: LinkText; }
    .cart__checkout, .cart__empty-action, .cart__quote-action { border-color: ButtonText; }
    .cart__checkout:disabled { color: GrayText; }
  }
</style>

<div class="cart page-width section-main-cart" id="main-cart-{{ section.id }}" data-m3d-cart-quote-required="{{ cart_has_quote }}">
  {%- if cart.item_count == 0 -%}
    <div class="cart--empty">
      <h1 class="cart__empty-heading">{{ 'sections.cart.empty' | t }}</h1>
      <p class="cart__empty-text">{{ 'm3d_cart.empty_description' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button m3d-motion-button cart__empty-action">
        {{ 'general.continue_shopping' | t }}
      </a>
    </div>
  {%- else -%}
    <h1 class="cart__title">{{ 'sections.cart.title' | t }}</h1>
    {%- form 'cart', cart, class: 'cart__form' -%}
      <div class="cart__contents">
        <div class="cart__items">
          <table class="cart-items">
            <caption class="visually-hidden">{{ 'sections.cart.caption' | t }}</caption>
            <thead>
              <tr>
                <th colspan="2" scope="col">{{ 'sections.cart.headings.product' | t }}</th>
                <th class="cart-items__heading--right" scope="col">{{ 'sections.cart.headings.quantity' | t }}</th>
                <th class="cart-items__heading--right" scope="col">{{ 'sections.cart.headings.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for item in cart.items -%}
                {%- liquid
                  assign item_requires_quote = false
                  if item.variant.price == 0 and item.original_price == 0
                    assign item_requires_quote = true
                  endif
                -%}
                <tr class="cart-item" data-line="{{ forloop.index }}">
                  <td class="cart-item__media">
                    {%- if item.image -%}
                      <a href="{{ item.url }}" aria-hidden="true" tabindex="-1">
                        {{
                          item.image
                          | image_url: width: 300
                          | image_tag:
                            loading: 'lazy',
                            widths: '100, 200, 300',
                            sizes: '100px',
                            class: 'cart-item__image',
                            alt: item.image.alt | escape
                        }}
                      </a>
                    {%- endif -%}
                  </td>

                  <td class="cart-item__details">
                    <a href="{{ item.url }}" class="cart-item__name">{{ item.product.title | escape }}</a>

                    {%- unless item.product.has_only_default_variant -%}
                      <p class="cart-item__options">
                        {%- for option in item.options_with_values -%}
                          {{ option.name | escape }}: {{ option.value | escape }}{%- unless forloop.last -%}, {% endunless -%}
                        {%- endfor -%}
                      </p>
                    {%- endunless -%}

                    {%- if item.selling_plan_allocation -%}
                      <p class="cart-item__options">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
                    {%- endif -%}

                    {%- unless item.properties == empty -%}
                      {%- for property in item.properties -%}
                        {%- assign first_char = property.first | slice: 0 -%}
                        {%- if property.last != blank and first_char != '_' -%}
                          <p class="cart-item__property">
                            {{ property.first | escape }}:&nbsp;
                            {%- assign upload_origin = property.last | slice: 0, 24 -%}
                            {%- if property.last contains '/uploads/' and upload_origin == 'https://cdn.shopify.com/' -%}
                              {%- if property.first contains 'Logótipo' -%}
                                {%- assign upload_extension = property.last | split: '?' | first | split: '.' | last | downcase -%}
                                {%- assign preview_extensions = 'png,jpg,jpeg,webp,gif' | split: ',' -%}
                                <a class="cart-item__logo" href="{{ property.last | escape }}" target="_blank" rel="noopener">{% if preview_extensions contains upload_extension %}<img src="{{ property.last | escape }}" width="40" height="40" loading="lazy" alt="{{ 'm3d_cart.uploaded_logo' | t }}">{% endif %}{{ 'm3d_cart.view_logo' | t }}</a>
                              {%- else -%}<a href="{{ property.last | escape }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last | escape }}</a>{%- endif -%}
                            {%- else -%}
                              {{ property.last | escape }}
                            {%- endif -%}
                          </p>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endunless -%}

                    {%- if item.line_level_discount_allocations.size > 0 -%}
                      <ul class="cart-item__discounts">
                        {%- for discount in item.line_level_discount_allocations -%}
                          <li>{{ discount.discount_application.title | escape }} (-{{ discount.amount | money }})</li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}

                    {%- if item.unit_price_measurement and item_requires_quote == false -%}
                      <p class="cart-item__unit-price">
                        {{ item.unit_price | money }}
                        {{ 'accessibility.unit_price_separator' | t }}
                        {%- if item.unit_price_measurement.reference_value != 1 -%}
                          {{ item.unit_price_measurement.reference_value }}
                        {%- endif -%}
                        {{ item.unit_price_measurement.reference_unit }}
                      </p>
                    {%- endif -%}
                  </td>

                  <td class="cart-item__quantity">
                    <div class="cart-item__quantity-wrapper">
                      <label class="visually-hidden" for="Quantity-{{ forloop.index }}">
                        {{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}
                      </label>
                      <div class="quantity-selector">
                        <button
                          type="button"
                          class="quantity__button"
                          name="minus"
                          aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}"
                        >{% render 'icon', name: 'm3d-minus' %}</button>
                        <input
                          class="quantity__input"
                          type="number"
                          name="updates[]"
                          id="Quantity-{{ forloop.index }}"
                          data-line="{{ forloop.index }}"
                          value="{{ item.quantity }}"
                          min="0"
                          step="1"
                          inputmode="numeric"
                        >
                        <button
                          type="button"
                          class="quantity__button"
                          name="plus"
                          aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}"
                        >{% render 'icon', name: 'm3d-plus' %}</button>
                      </div>
                      <a
                        href="{{ item.url_to_remove }}"
                        class="cart-item__remove"
                        aria-label="{{ 'sections.cart.remove_title' | t: title: item.product.title | escape }}"
                      >
                        {% render 'icon', name: 'm3d-trash', size: 16 %}{{ 'sections.cart.remove' | t }}
                      </a>
                    </div>
                  </td>

                  <td class="cart-item__price">
                    {%- if item_requires_quote -%}
                      <span class="cart-item__consultation">{{ 'm3d_cart.price_on_request' | t }}</span>
                    {%- else -%}
                      <span class="visually-hidden">{{ 'm3d_cart.unit_price' | t }}:</span>
                      {%- if item.original_price != item.final_price -%}
                        <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }} {{ item.original_price | money }}.</span>
                        <s aria-hidden="true">{{ item.original_price | money }}</s>
                        <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}:</span>
                        <span class="cart-item__discounted">{{ item.final_price | money }}</span>
                      {%- else -%}
                        <span>{{ item.final_price | money }}</span>
                      {%- endif -%}
                      {%- if item.quantity > 1 -%}
                        <div class="cart-item__unit-price"><span class="visually-hidden">{{ 'm3d_cart.line_total' | t }}:</span>{{ item.final_line_price | money }}</div>
                      {%- endif -%}
                    {%- endif -%}
                  </td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>

        <div class="cart__summary">
          {%- if section.settings.show_note -%}
            <label class="cart__note-label" for="Cart-note">{{ 'sections.cart.note' | t }}</label>
            <textarea
              class="cart__note field__input"
              name="note"
              id="Cart-note"
              rows="3"
              spellcheck="false"
            >{{ cart.note | escape }}</textarea>
          {%- endif -%}

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="cart__discounts">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li>{{ discount.title | escape }} (-{{ discount.total_allocated_amount | money }})</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="cart__quote-notice" id="CartQuoteNotice-{{ section.id }}" role="status" tabindex="-1" data-m3d-cart-quote-notice {% unless cart_has_quote %}hidden{% endunless %}>
            <p>{{ 'm3d_cart.quote_required' | t }}</p>
            {%- if cart_quote_url != blank -%}
              <a class="cart__quote-action" href="{{ cart_quote_url }}">{{ 'm3d_cart.quote_action' | t }}</a>
            {%- endif -%}
          </div>
          <div class="cart__subtotal">
            <span>{{ 'sections.cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          <p class="cart__partial-note" data-m3d-cart-partial-note {% unless cart_has_quote %}hidden{% endunless %}>{{ 'm3d_cart.partial_total' | t }}</p>
          <p class="cart__tax-note">
            {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
              {{ 'sections.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
            {%- elsif cart.taxes_included -%}
              {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
            {%- elsif shop.shipping_policy.body != blank -%}
              {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
            {%- else -%}
              {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
            {%- endif -%}
          </p>

          <button type="submit" name="update" class="button button--secondary cart__update">
            {{ 'sections.cart.update' | t }}
          </button>

          <button type="submit" name="checkout" class="button cart__checkout m3d-motion-button" data-m3d-checkout {% if cart_has_quote %}disabled aria-describedby="CartQuoteNotice-{{ section.id }}" data-m3d-quote-disabled="true"{% endif %}>
            {{ 'sections.cart.checkout' | t }}
          </button>

          {%- if shop.customer_accounts_enabled and customer == blank -%}
            {%- assign cart_login_prefix = 'M3DCartLogin-' | append: section.id -%}
            <a href="{{ routes.storefront_login_url }}" class="m3d-auth__link cart__login" data-m3d-dialog-open="{{ cart_login_prefix }}-dialog">{{ 'm3d_auth.cart_login_link' | t }}</a>
          {%- endif -%}

          {%- if additional_checkout_buttons and cart_has_quote == false -%}
            <div class="cart__additional-checkout" data-m3d-additional-checkout>
              {{ content_for_additional_checkout_buttons }}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endform -%}
  {%- endif -%}
</div>

{%- assign cart_login_prefix = 'M3DCartLogin-' | append: section.id -%}
{% render 'm3d-cart-login', id_prefix: cart_login_prefix %}

<script>
  (function () {
    var root = document.getElementById('main-cart-{{ section.id }}');
    if (!root) return;

    function refresh() {
      window.location.reload();
    }

    function changeLine(line, quantity) {
      fetch('{{ routes.cart_change_url }}.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ line: line, quantity: quantity })
      })
        .then(function () { refresh(); })
        .catch(function () { refresh(); });
    }

    root.addEventListener('click', function (event) {
      var button = event.target.closest('.quantity__button');
      if (!button) return;
      event.preventDefault();
      var input = button.parentElement.querySelector('.quantity__input');
      if (!input) return;
      var current = parseInt(input.value, 10) || 0;
      var next = button.name === 'plus' ? current + 1 : Math.max(0, current - 1);
      changeLine(parseInt(input.dataset.line, 10), next);
    });

    root.addEventListener('change', function (event) {
      var input = event.target.closest('.quantity__input');
      if (!input) return;
      changeLine(parseInt(input.dataset.line, 10), Math.max(0, parseInt(input.value, 10) || 0));
    });
  })();
</script>

