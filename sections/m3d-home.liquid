{%- liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank
    assign featured_collection = collections['all']
  endif
  assign hero_product = section.settings.hero_product | default: featured_collection.products.first
  assign quote_page = pages['pedir-orcamento']
  assign quote_url = quote_page.url | append: '?view=m3d-quote'
  assign wear_collection = collections['t-shirts']
  assign bags_collection = collections['bags']
  assign valid_categories = 0
  for block in section.blocks
    if block.settings.collection != blank and block.settings.collection.products_count > 0
      assign valid_categories = valid_categories | plus: 1
    endif
  endfor
-%}
{{ 'm3d-home.css' | asset_url | stylesheet_tag }}
<section class="m3d-home" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="m3d-home-hero">
      <div class="m3d-home-hero__content">
        <h1>{{ section.settings.hero_heading | escape }}</h1>
        <p>{{ section.settings.hero_text | escape }}</p>
        <a class="m3d-button m3d-button--primary" href="{{ routes.all_products_collection_url }}">{{ 'm3d_home.explore_products' | t }}</a>
        {% if quote_page != blank %}<a class="m3d-home-hero__business" href="#M3dEmpresas-{{ section.id }}">{{ 'm3d_home.business' | t }}</a>{% endif %}
      </div>
      <div class="m3d-home-hero__visual">
        <img class="m3d-home-hero__brush" src="{{ 'pincelada-m.svg' | asset_url }}" width="930" height="600" alt="" aria-hidden="true">
        {% if hero_product.featured_image != blank %}
          <a class="m3d-home-hero__product" href="{{ hero_product.url }}">
            {{ hero_product.featured_image | image_url: width: 1000 | image_tag: widths: '360, 540, 750, 1000', sizes: '(max-width: 749px) 82vw, 42vw', loading: 'eager', fetchpriority: 'high', alt: hero_product.title }}
            <span class="visually-hidden">{{ hero_product.title | escape }}</span>
          </a>
        {% elsif section.settings.hero_image != blank %}
          {{ section.settings.hero_image | image_url: width: 1000 | image_tag: class: 'm3d-home-hero__photo', widths: '360, 540, 750, 1000', sizes: '(max-width: 749px) 90vw, 42vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_alt }}
        {% endif %}
      </div>
    </div>
    {% if valid_categories > 0 %}
      <section class="m3d-home-categories" aria-labelledby="M3dCategories-{{ section.id }}">
        <div class="m3d-home-heading"><h2 id="M3dCategories-{{ section.id }}">{{ 'm3d_home.categories_heading' | t }}</h2><a href="{{ routes.collections_url }}">{{ 'm3d_home.all_categories' | t }}</a></div>
        <ul class="m3d-home-categories__grid" role="list">
          {% for block in section.blocks %}
            {% assign category = block.settings.collection %}
            {% if category != blank and category.products_count > 0 %}
              {% assign category_image = block.settings.image | default: category.image | default: category.products.first.featured_image %}
              <li {{ block.shopify_attributes }}><a class="m3d-home-category" href="{{ category.url }}">
                <div>{% if category_image != blank %}{{ category_image | image_url: width: 600 | image_tag: widths: '240, 360, 480, 600', sizes: '(max-width: 749px) 43vw, 18vw', loading: 'lazy', alt: '' }}{% endif %}</div>
                <span>{{ block.settings.title | default: category.title | escape }}</span>
              </a></li>
            {% endif %}
          {% endfor %}
        </ul>
      </section>
    {% endif %}
    {% if featured_collection.products.size > 0 %}
      <section class="m3d-home-products" aria-labelledby="M3dProducts-{{ section.id }}">
        <div class="m3d-home-heading"><h2 id="M3dProducts-{{ section.id }}">{{ section.settings.products_heading | escape }}</h2><a href="{{ featured_collection.url }}">{{ 'm3d_home.see_all' | t }}</a></div>
        <ul class="m3d-home-products__grid" role="list">
          {% for product in featured_collection.products limit: section.settings.products_to_show %}<li>{% render 'card-product', card_product: product %}</li>{% endfor %}
        </ul>
      </section>
    {% endif %}
  </div>
  {% if quote_page != blank %}
    <aside id="M3dEmpresas-{{ section.id }}" class="m3d-home-business">
      <div class="page-width m3d-home-business__inner">
        <div><img src="{{ 'logo-m3d-horizontal-negativo.svg' | asset_url }}" width="209" height="40" alt="{{ shop.name | escape }}" loading="lazy"><h2>{{ 'm3d_home.business' | t }}</h2><p>{{ 'm3d_home.business_text' | t }}</p></div>
        <a class="m3d-button m3d-button--inverse" href="{{ quote_url }}">{{ 'm3d_pdp.request_quote' | t }}</a>
      </div>
    </aside>
  {% endif %}
  <div class="page-width">
    <section class="m3d-home-process" aria-labelledby="M3dProcess-{{ section.id }}">
      <h2 id="M3dProcess-{{ section.id }}">{{ 'm3d_home.process_heading' | t }}</h2>
      <ol>
        <li><h3>{{ 'm3d_home.step_product' | t }}</h3><p>{{ 'm3d_home.step_product_text' | t }}</p></li>
        <li><h3>{{ 'm3d_home.step_idea' | t }}</h3><p>{{ 'm3d_home.step_idea_text' | t }}</p></li>
        <li><h3>{{ 'm3d_home.step_request' | t }}</h3><p>{{ 'm3d_home.step_request_text' | t }}</p></li>
      </ol>
    </section>
    {% if wear_collection.products_count > 0 or bags_collection.products_count > 0 %}
    <div class="m3d-home-selections">
      {% assign wear_collection = collections['t-shirts'] %}
      {% assign bags_collection = collections['bags'] %}
      {% if wear_collection != blank and wear_collection.products_count > 0 %}<article><a href="{{ wear_collection.url }}"><div>{{ wear_collection.products.first.featured_image | image_url: width: 720 | image_tag: widths: '360, 540, 720', sizes: '(max-width: 749px) 90vw, 45vw', loading: 'lazy', alt: '' }}</div><h2>{{ 'm3d_home.wear_heading' | t }}</h2><span>{{ 'm3d_home.explore_wear' | t }}</span></a></article>{% endif %}
      {% if bags_collection != blank and bags_collection.products_count > 0 %}<article><a href="{{ bags_collection.url }}"><div>{{ bags_collection.products.first.featured_image | image_url: width: 720 | image_tag: widths: '360, 540, 720', sizes: '(max-width: 749px) 90vw, 45vw', loading: 'lazy', alt: '' }}</div><h2>{{ 'm3d_home.bags_heading' | t }}</h2><span>{{ 'm3d_home.explore_bags' | t }}</span></a></article>{% endif %}
    </div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Homepage M3D",
  "settings": [
    {"type":"textarea","id":"hero_heading","label":"Título principal","default":"O seu nome, a sua marca, em objetos do dia a dia."},
    {"type":"textarea","id":"hero_text","label":"Texto principal","default":"Para oferecer, para usar ou para levar a sua empresa mais longe."},
    {"type":"product","id":"hero_product","label":"Produto em destaque no hero"},
    {"type":"image_picker","id":"hero_image","label":"Imagem alternativa do hero"},
    {"type":"text","id":"hero_alt","label":"Descrição da imagem","default":"Objetos para personalizar"},
    {"type":"text","id":"products_heading","label":"Título dos produtos","default":"Encontre a sua próxima ideia"},
    {"type":"collection","id":"collection","label":"Coleção de produtos"},
    {"type":"range","id":"products_to_show","min":2,"max":8,"step":1,"default":4,"label":"Produtos apresentados"}
  ],
  "blocks":[{"type":"category","name":"Categoria","settings":[{"type":"collection","id":"collection","label":"Coleção"},{"type":"text","id":"title","label":"Nome apresentado"},{"type":"image_picker","id":"image","label":"Imagem alternativa"}]}],
  "max_blocks":5,
  "presets":[{"name":"Homepage M3D"}]
}
{% endschema %}
