{%- comment -%}
  ============================================================
  CONTACT FORM — formulário de contato nativo
  ============================================================

  O QUE FAZ:
  Renderiza o formulário de contato usando {% form 'contact' %} do
  Shopify (envia email para a loja). Campos: nome, email (required),
  telefone e mensagem. Mostra avisos de sucesso e de erros de validação.

  ONDE É USADA:
  Template page.contact (ou onde a seção for adicionada via preset).

  PRINCIPAIS PARTES:
  - form 'contact': envio nativo, sem backend próprio
  - Pré-preenche valores com dados do customer, se logado
  - Bloco de erros com âncoras para cada campo inválido
  - Telefone usa type="tel"; textarea permite resize vertical
  - Setting: heading; tem preset (aparece no theme editor)

  OBSERVAÇÕES:
  Os name= de nome/telefone usam a label traduzida (padrão Shopify).
  Estilos em assets/m3d-content.css; heading preenchido vem do editor.
{%- endcomment -%}

{%- assign form_id = 'ContactForm-' | append: section.id -%}

<section class="contact page-width" data-section-id="{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h1 class="contact__heading">{{ section.settings.heading | escape }}</h1>
  {%- endif -%}

  {%- form 'contact', id: form_id, class: 'contact__form' -%}
    {%- if form.posted_successfully? -%}
      <div class="contact__notice contact__notice--success" role="status" tabindex="-1">{% render 'icon', name: 'm3d-check' %}
        {{ 'templates.contact.form.post_success' | t }}
      </div>
    {%- elsif form.errors -%}
      <div class="contact__notice contact__notice--error" role="alert" tabindex="-1">{% render 'icon', name: 'm3d-alert' %}
        <h2 class="contact__notice-title">{{ 'templates.contact.form.error_heading' | t }}</h2>
        <ul class="contact__errors" role="list">
          {%- for field in form.errors -%}
            <li>
              {%- if field == 'email' or field == 'name' or field == 'phone' or field == 'body' -%}
                <a href="#ContactForm-{{ field }}-{{ section.id }}">
                  {{ form.errors.translated_fields[field] | capitalize | escape }}
                  {{ form.errors.messages[field] | escape }}
                </a>
              {%- else -%}
                {{ form.errors.messages[field] | escape }}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <div class="contact__field">
      <label class="field__label contact__label" for="ContactForm-name-{{ section.id }}">
        {{ 'templates.contact.form.name' | t }}
      </label>
      <input
        type="text"
        class="field__input contact__input"
        id="ContactForm-name-{{ section.id }}"
        name="contact[{{ 'templates.contact.form.name' | t | escape }}]"
        value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
        autocomplete="name"
        spellcheck="false"
      >
    </div>

    <div class="contact__field">
      <label class="field__label contact__label" for="ContactForm-email-{{ section.id }}">
        {{ 'templates.contact.form.email' | t }}
      </label>
      <input
        type="email"
        class="field__input contact__input"
        id="ContactForm-email-{{ section.id }}"
        name="contact[email]"
        value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
        autocomplete="email"
        autocapitalize="off"
        spellcheck="false"
        {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="ContactForm-email-error-{{ section.id }}"{% endif %}
        required
      >
    </div>

    {%- if form.errors contains 'email' -%}
      <p class="contact__field-error" id="ContactForm-email-error-{{ section.id }}">{{ form.errors.messages.email | escape }}</p>
    {%- endif -%}

    <div class="contact__field">
      <label class="field__label contact__label" for="ContactForm-phone-{{ section.id }}">
        {{ 'templates.contact.form.phone' | t }}
      </label>
      <input
        type="tel"
        class="field__input contact__input"
        id="ContactForm-phone-{{ section.id }}"
        name="contact[{{ 'templates.contact.form.phone' | t | escape }}]"
        value="{% if form.phone %}{{ form.phone | escape }}{% elsif customer %}{{ customer.phone | escape }}{% endif %}"
        autocomplete="tel"
        spellcheck="false"
      >
    </div>

    <div class="contact__field">
      <label class="field__label contact__label" for="ContactForm-body-{{ section.id }}">
        {{ 'templates.contact.form.comment' | t }}
      </label>
      <textarea
        rows="6"
        class="field__input contact__input contact__textarea"
        id="ContactForm-body-{{ section.id }}"
        name="contact[body]"
        spellcheck="false"
      >{% if form.body %}{{ form.body | escape }}{% endif %}</textarea>
    </div>

    <button type="submit" class="button contact__submit">
      {{ 'templates.contact.form.send' | t }}
    </button>
  {%- endform -%}
</section>



{% schema %}
{
  "name": "t:sections.contact_form.name",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.contact_form.settings.heading.label",
      "default": "Contactos"
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact_form.name"
    }
  ]
}
{% endschema %}
