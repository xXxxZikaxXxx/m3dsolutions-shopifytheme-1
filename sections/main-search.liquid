  #shopify-section-{{ section.id }} .collection-card__shop-list input { position: absolute; opacity: 0; pointer-events: none; }
  #shopify-section-{{ section.id }} .collection-card__shop-list label:has(input:checked) { background: #f0edff; color: #4436bc; }
