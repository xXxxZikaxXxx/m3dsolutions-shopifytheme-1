  #shopify-section-{{ section.id }} .collection-card__dialog-footer { padding: 16px 20px; border-top: 1px solid #ededed; background: #f7f7f7; text-align: center; }
  #shopify-section-{{ section.id }} .collection-card__create-shop { min-height: 40px; padding: 0 16px; border: 1px solid #d6d6d6; border-radius: 10px; background: #fff; color: #4436bc; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease; }
  #shopify-section-{{ section.id }} .collection-card__create-shop:hover { transform: scale(1.03); border-color: #4436bc; box-shadow: 0 5px 14px rgba(68,54,188,.12); }
