  #shopify-section-{{ section.id }} .collection-card__save[aria-pressed="true"] { border-color: #e31c79; color: #e31c79; }
  #shopify-section-{{ section.id }} .collection-card__save[aria-pressed="true"] .collection-card__heart-icon { fill: #e31c79; stroke: #e31c79; animation: collection-heart-pop 240ms cubic-bezier(.22,.61,.36,1); }
  #shopify-section-{{ section.id }} .collection-card__badge { position: absolute; z-index: 2; top: 12px; right: 12px; padding: 7px 10px; background: #e31c79; color: #fff; font-size: 11px; font-weight: 700; line-height: 1; letter-spacing: .03em; text-transform: uppercase; }
