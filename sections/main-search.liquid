{%- comment -%}
  Product-only search results using the same information architecture as collection PLPs.
  Exact full title or SKU searches redirect to the matching product page.
{%- endcomment -%}

{%- liquid
  assign normalized_term = search.terms | strip | downcase
  assign exact_product_url = blank
  assign current_sort = search.sort_by | default: search.default_sort_by
  assign active_filter_count = 0
  assign material_label = 'sections.main_collection.material' | t
  assign printing_label = 'sections.main_collection.printing_technique' | t
  assign color_label = 'sections.main_collection.color' | t
  assign stock_label = 'sections.main_collection.stock' | t
  assign labeling_label = 'sections.main_collection.labeling' | t

  if search.performed and normalized_term != blank
    for result in search.results
      if result.object_type == 'product'
        assign normalized_title = result.title | strip | downcase
        if normalized_title == normalized_term
          assign exact_product_url = result.url
          break
        endif
        for variant in result.variants
          assign normalized_sku = variant.sku | strip | downcase
          if normalized_sku != blank and normalized_sku == normalized_term
            assign exact_product_url = result.url
            break
          endif
        endfor
        if exact_product_url != blank
          break
        endif
      endif
    endfor
  endif

  for filter in search.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endif
  endfor
-%}

{%- if exact_product_url != blank -%}
  <script>window.location.replace({{ exact_product_url | json }});</script>
{%- endif -%}

<div class="search-plp page-width" data-search-plp="{{ section.id }}">
  <nav class="search-plp__breadcrumb" aria-label="{{ 'sections.collection_banner.breadcrumb_label' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ 'templates.search.title' | t }}</span>
  </nav>

  <div class="search-plp__header">
    <h1>{{ 'templates.search.search_for' | t: terms: search.terms }}</h1>
  </div>

  {%- if search.performed -%}
    {%- paginate search.results by 16 -%}
      {%- if search.results_count == 0 -%}
        <div class="collection__empty">
          <p>{{ 'templates.search.no_results' | t: terms: search.terms }}</p>
        </div>
      {%- else -%}
        <div class="collection__mobile-toolbar">
          <span class="collection__count">{{ 'products.facets.product_count_simple' | t: count: search.results_count }}</span>
          <button type="button" class="collection__filter-trigger" aria-controls="SearchSidebar-{{ section.id }}" aria-expanded="false">
            {{ 'sections.main_collection.filters_and_sort' | t }}
            {%- if active_filter_count > 0 -%}<span>({{ active_filter_count }})</span>{%- endif -%}
          </button>
        </div>

        <div class="collection__layout">
          <aside class="collection__sidebar" id="SearchSidebar-{{ section.id }}" aria-label="{{ 'products.facets.filter_by_label' | t }}">
            <div class="collection__sidebar-header">
              <h2>{{ 'sections.main_collection.filters_and_sort' | t }}</h2>
              <button type="button" class="collection__sidebar-close" aria-label="{{ 'accessibility.close' | t }}">×</button>
            </div>

            <form method="get" action="{{ routes.search_url }}" class="collection__filters">
              <input type="hidden" name="q" value="{{ search.terms | escape }}">
              <input type="hidden" name="type" value="product">
              <input type="hidden" name="options[prefix]" value="last">

              <details class="collection__filter" open>
                <summary class="collection__filter-summary">
                  <span>{{ 'sections.main_collection.sort_by' | t }}</span>
                  <svg class="collection__filter-chevron" aria-hidden="true" viewBox="0 0 16 16"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>
                </summary>
                <div class="collection__filter-content">
                  <ul class="collection__filter-values" role="list">
                    <li class="collection__filter-value">
                      <input class="collection__filter-radio" type="radio" name="sort_by" value="price-ascending" id="SearchSort-{{ section.id }}-ascending" {% if current_sort == 'price-ascending' %}checked{% endif %}>
                      <label for="SearchSort-{{ section.id }}-ascending">{{ 'sections.main_collection.price_ascending' | t }}</label>
                    </li>
                    <li class="collection__filter-value">
                      <input class="collection__filter-radio" type="radio" name="sort_by" value="price-descending" id="SearchSort-{{ section.id }}-descending" {% if current_sort == 'price-descending' %}checked{% endif %}>
                      <label for="SearchSort-{{ section.id }}-descending">{{ 'sections.main_collection.price_descending' | t }}</label>
                    </li>
                  </ul>
                </div>
              </details>

              {% render 'collection-filter-group', filters: search.filters, group: 'material', label: material_label, section_id: section.id %}
              {% render 'collection-filter-group', filters: search.filters, group: 'printing', label: printing_label, section_id: section.id %}
              {% render 'collection-filter-group', filters: search.filters, group: 'color', label: color_label, section_id: section.id %}
              {% render 'collection-filter-group', filters: search.filters, group: 'stock', label: stock_label, section_id: section.id %}
              {% render 'collection-filter-group', filters: search.filters, group: 'labeling', label: labeling_label, section_id: section.id %}

              <div class="collection__filter-actions">
                <button type="submit" class="collection__filter-apply">{{ 'products.facets.apply' | t }}</button>
                <a href="{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product&options%5Bprefix%5D=last" class="collection__filter-clear">{{ 'products.facets.clear_all' | t }}</a>
              </div>
            </form>
          </aside>

          <button type="button" class="collection__drawer-backdrop" tabindex="-1" aria-label="{{ 'accessibility.close' | t }}"></button>
          <div class="collection__divider" aria-hidden="true"></div>

          <div class="collection__products">
            <p class="collection__desktop-count">{{ 'products.facets.product_count_simple' | t: count: search.results_count }}</p>
            <ul class="collection__product-grid" role="list">
              {%- for item in search.results -%}
                {%- if item.object_type == 'product' -%}
                  <li>{% render 'card-product', card_product: item, card_context: 'collection' %}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
            {% render 'pagination', paginate: paginate %}
          </div>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

<style>
