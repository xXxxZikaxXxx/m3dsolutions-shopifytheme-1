  @keyframes collection-shop-item-in { to { opacity: 1; transform: translateY(0); } }
  #shopify-section-{{ section.id }} .collection__empty { padding: 72px 0; text-align: center; }
  #shopify-section-{{ section.id }} .pagination { margin-top: 48px; }
  #shopify-section-{{ section.id }} .pagination__list { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px; margin: 0; padding: 0; list-style: none; }
  #shopify-section-{{ section.id }} .pagination__item { display: inline-flex; min-width: 40px; min-height: 40px; align-items: center; justify-content: center; padding: 0 12px; border: 1px solid #dedede; border-radius: 999px; background: #fff; color: #000; font-size: 13px; font-weight: 600; line-height: 1; text-decoration: none; transition: transform 180ms cubic-bezier(.22,.61,.36,1), background-color 180ms ease, border-color 180ms ease, color 180ms ease, box-shadow 180ms ease; }
  #shopify-section-{{ section.id }} a.pagination__item:hover { transform: scale(1.06); border-color: #000; background: #000; color: #fff; box-shadow: 0 5px 14px rgba(0,0,0,.12); }
  #shopify-section-{{ section.id }} a.pagination__item:active { transform: scale(.98); }
  #shopify-section-{{ section.id }} a.pagination__item:focus-visible { outline: 2px solid #4436bc; outline-offset: 2px; }
  #shopify-section-{{ section.id }} .pagination__item--current { border-color: #000; background: #000; color: #fff; }
  #shopify-section-{{ section.id }} .pagination__item--prev,
  #shopify-section-{{ section.id }} .pagination__item--next { width: 44px; height: 44px; padding: 0; font-size: 18px; }
  #shopify-section-{{ section.id }} .pagination__item--gap { min-width: 24px; padding: 0; border-color: transparent; background: transparent; }
  #shopify-section-{{ section.id }} .collection__drawer-backdrop { display: none; }

  @media screen and (max-width: 989px) {
