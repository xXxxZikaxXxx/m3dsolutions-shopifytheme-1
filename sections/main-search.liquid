    #shopify-section-{{ section.id }} .collection__mobile-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
    #shopify-section-{{ section.id }} .collection__count { color: #5f5f5f; font-size: 13px; }
    #shopify-section-{{ section.id }} .collection__filter-trigger { min-height: 42px; padding: 0 16px; border: 1px solid #000; border-radius: var(--buttons-radius, 10px); background: #fff; color: #000; font: inherit; font-size: 13px; cursor: pointer; }
    #shopify-section-{{ section.id }} .collection__sidebar { position: fixed; z-index: 52; inset: 0 auto 0 0; width: min(360px, 90vw); height: 100dvh; padding: 20px 24px 32px; overflow-y: auto; transform: translateX(-102%); visibility: hidden; transition: transform 320ms cubic-bezier(.22,.61,.36,1), visibility 0s linear 320ms; }
    #shopify-section-{{ section.id }} .collection__sidebar.is-open { transform: translateX(0); visibility: visible; transition-delay: 0s; }
    #shopify-section-{{ section.id }} .collection__sidebar-header { display: flex; min-height: 52px; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
    #shopify-section-{{ section.id }} .collection__sidebar-header h2 { margin: 0; font-size: 20px; }
    #shopify-section-{{ section.id }} .collection__sidebar-close { width: 40px; height: 40px; padding: 0; border: 0; border-radius: 10px; background: transparent; color: #000; font-size: 28px; cursor: pointer; }
    #shopify-section-{{ section.id }} .collection__drawer-backdrop { position: fixed; z-index: 51; inset: 0; display: block; border: 0; opacity: 0; visibility: hidden; background: rgba(0,0,0,.38); backdrop-filter: blur(3px); transition: opacity 240ms ease, visibility 0s linear 240ms; }
    #shopify-section-{{ section.id }} .collection__drawer-backdrop.is-open { opacity: 1; visibility: visible; transition-delay: 0s; }
    #shopify-section-{{ section.id }} .collection__product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 16px; }
  }

  @media screen and (max-width: 520px) {
    #shopify-section-{{ section.id }} .search-plp__header h1 { font-size: 28px; }
    #shopify-section-{{ section.id }} .collection-card__actions { top: 8px; left: 8px; }
    #shopify-section-{{ section.id }} .collection-card__badge { top: 8px; right: 8px; padding: 6px 8px; font-size: 9px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .collection-card__image,
    #shopify-section-{{ section.id }} .collection__sidebar,
    #shopify-section-{{ section.id }} .collection__drawer-backdrop,
    #shopify-section-{{ section.id }} .collection__filter-chevron,
    #shopify-section-{{ section.id }} .collection-card__dialog,
    #shopify-section-{{ section.id }} .collection-card__heart-icon,
    #shopify-section-{{ section.id }} .collection-card__shop-list label,
    #shopify-section-{{ section.id }} .pagination__item { transition: none; }
    #shopify-section-{{ section.id }} .collection-card__dialog[open] .collection-card__shop-list label,
    #shopify-section-{{ section.id }} .collection-card__save[aria-pressed="true"] .collection-card__heart-icon { animation: none; opacity: 1; transform: none; }
  }
</style>

<script>
  (() => {
    const root = document.querySelector('[data-search-plp="{{ section.id }}"]');
    if (!root || root.dataset.enhanced === 'true') return;
    root.dataset.enhanced = 'true';

    const currentUrl = new URL(window.location.href);
    {%- if exact_product_url == blank -%}
    if (currentUrl.searchParams.get('type') !== 'product') {
      currentUrl.searchParams.set('type', 'product');
      currentUrl.searchParams.set('options[prefix]', 'last');
      window.location.replace(currentUrl.toString());
      return;
    }
    {%- endif -%}

    const sidebar = root.querySelector('.collection__sidebar');
    const trigger = root.querySelector('.collection__filter-trigger');
    const closeButton = root.querySelector('.collection__sidebar-close');
    const backdrop = root.querySelector('.collection__drawer-backdrop');
    let lastTrigger = null;

    const setDrawer = (open) => {
      if (!sidebar || !trigger || !backdrop) return;
      sidebar.classList.toggle('is-open', open);
      backdrop.classList.toggle('is-open', open);
      trigger.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) {
        lastTrigger = document.activeElement;
        requestAnimationFrame(() => closeButton?.focus());
      } else if (lastTrigger) {
        lastTrigger.focus();
      }
    };

    trigger?.addEventListener('click', () => setDrawer(true));
    closeButton?.addEventListener('click', () => setDrawer(false));
    backdrop?.addEventListener('click', () => setDrawer(false));

    root.addEventListener('click', (event) => {
      const saveButton = event.target.closest('[data-card-save]');
      if (saveButton) {
        const card = saveButton.closest('.collection-card');
        const nextPressed = saveButton.getAttribute('aria-pressed') !== 'true';
        card?.querySelectorAll('[data-card-save]').forEach((button) => button.setAttribute('aria-pressed', String(nextPressed)));
        return;
      }

      const myShopButton = event.target.closest('[data-open-myshop]');
      if (myShopButton) {
        document.getElementById(myShopButton.dataset.openMyshop)?.showModal();
        return;
      }

      const dialogClose = event.target.closest('[data-close-dialog]');
      if (dialogClose) dialogClose.closest('dialog')?.close();
    });

    root.querySelectorAll('.collection-card__dialog').forEach((dialog) => {
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && sidebar?.classList.contains('is-open')) setDrawer(false);
    });
  })();
</script>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "tag": "section",
  "class": "section-main-search",
  "settings": []
}
{% endschema %}
