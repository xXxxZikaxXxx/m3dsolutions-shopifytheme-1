  #shopify-section-{{ section.id }} .collection-card__dialog::backdrop { background: rgba(0,0,0,.48); backdrop-filter: blur(6px); opacity: 0; transition: opacity 220ms ease, display 220ms allow-discrete, overlay 220ms allow-discrete; }
  #shopify-section-{{ section.id }} .collection-card__dialog[open]::backdrop { opacity: 1; }
  #shopify-section-{{ section.id }} .collection-card__dialog-header { position: relative; display: flex; min-height: 72px; align-items: center; justify-content: center; padding: 20px 56px; border-bottom: 1px solid #ededed; }
  #shopify-section-{{ section.id }} .collection-card__dialog-title { margin: 0; font-size: 18px; line-height: 1.2; text-align: center; }
  #shopify-section-{{ section.id }} .collection-card__dialog-close { position: absolute; top: 18px; right: 18px; display: grid; width: 36px; height: 36px; place-items: center; padding: 0; border: 0; border-radius: 10px; background: transparent; font-size: 24px; cursor: pointer; transition: background 180ms ease, transform 180ms ease; }
  #shopify-section-{{ section.id }} .collection-card__dialog-close:hover { background: #f3f3f3; transform: scale(1.05); }
  #shopify-section-{{ section.id }} .collection-card__dialog-body { padding: 10px; }
  #shopify-section-{{ section.id }} .collection-card__shop-list { display: grid; gap: 4px; margin: 0; padding: 0; border: 0; }
