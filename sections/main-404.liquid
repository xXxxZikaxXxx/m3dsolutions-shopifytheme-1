{%- comment -%}
  Native 404 search and a collection exit. Copy belongs to locale files.
  Styles: assets/m3d-content.css, loaded globally by the layout.
{%- endcomment -%}

<section class="notfound page-width" data-section-id="{{ section.id }}">
  <div class="notfound__inner">
    <p class="notfound__code" aria-hidden="true">404</p>
    <h1 class="notfound__title">{{ 'general.404.title' | t }}</h1>
    <p class="notfound__subtext">{{ 'general.404.subtext' | t }}</p>

    <form action="{{ routes.search_url }}" method="get" role="search" class="notfound__search">
      <label class="visually-hidden" for="Search404-{{ section.id }}">{{ 'm3d_content.search_label' | t }}</label>
      <input
        type="search"
        class="field__input notfound__search-input"
        id="Search404-{{ section.id }}"
        name="q"
        placeholder="{{ 'm3d_content.search_placeholder' | t | escape }}"
        spellcheck="false"
        autocomplete="off"
      >
      <button type="submit" class="button notfound__search-submit">{{ 'm3d_content.search_submit' | t }}</button>
    </form>

    <a href="{{ routes.all_products_collection_url }}" class="button notfound__explore">{{ 'm3d_content.explore_products' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_404.name",
  "tag": "section",
  "class": "section-main-404",
  "settings": []
}
{% endschema %}
