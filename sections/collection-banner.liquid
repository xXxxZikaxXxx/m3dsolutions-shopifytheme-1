{%- comment -%}
  Collection breadcrumb, title, optional image and description.
{%- endcomment -%}

<div class="collection-banner page-width" data-section-id="{{ section.id }}">
  <nav class="collection-banner__breadcrumb" aria-label="{{ 'sections.collection_banner.breadcrumb_label' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
    <span aria-hidden="true">/</span>
    <a href="{{ routes.all_products_collection_url }}">{{ 'sections.collection_banner.products' | t }}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ collection.title | escape }}</span>
  </nav>

  {%- if section.settings.show_image and collection.image -%}
    <div class="collection-banner__media">
      {{
        collection.image
        | image_url: width: 1920
        | image_tag:
          loading: 'eager',
          sizes: '100vw',
          widths: '540, 720, 900, 1080, 1440, 1920',
          class: 'collection-banner__image',
          alt: collection.image.alt | default: collection.title | escape
      }}
    </div>
  {%- endif -%}

  <div class="collection-banner__text">
    <h1 class="collection-banner__title">{{ collection.title }}</h1>
    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="collection-banner__description rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} { background: #fff; }
  #shopify-section-{{ section.id }} .collection-banner { padding-top: 30px; padding-bottom: 34px; }
  #shopify-section-{{ section.id }} .collection-banner__breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 34px; color: #666; font-size: 12px; line-height: 1.5; }
  #shopify-section-{{ section.id }} .collection-banner__breadcrumb a { color: #4436bc; text-decoration: none; }
  #shopify-section-{{ section.id }} .collection-banner__breadcrumb a:hover { text-decoration: underline; text-underline-offset: 3px; }
  #shopify-section-{{ section.id }} .collection-banner__media { width: 100%; margin-bottom: 28px; overflow: hidden; background: #f4f4f4; }
  #shopify-section-{{ section.id }} .collection-banner__image { display: block; width: 100%; height: auto; }
  #shopify-section-{{ section.id }} .collection-banner__text { max-width: 760px; }
  #shopify-section-{{ section.id }} .collection-banner__title { margin: 0; color: #000; font-size: clamp(32px, 4vw, 52px); line-height: 1.05; letter-spacing: -.025em; }
  #shopify-section-{{ section.id }} .collection-banner__description { margin-top: 14px; color: #5c5c5c; font-size: 15px; line-height: 1.65; }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .collection-banner { padding-top: 22px; padding-bottom: 28px; }
    #shopify-section-{{ section.id }} .collection-banner__breadcrumb { margin-bottom: 24px; }
  }
</style>

{% schema %}
{
  "name": "t:sections.collection_banner.name",
  "tag": "section",
  "class": "section-collection-banner",
  "settings": [
    { "type": "checkbox", "id": "show_description", "default": true, "label": "t:sections.collection_banner.settings.show_description.label" },
    { "type": "checkbox", "id": "show_image", "default": false, "label": "t:sections.collection_banner.settings.show_image.label" }
  ]
}
{% endschema %}
