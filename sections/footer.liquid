{%- comment -%}
  ============================================================
  FOOTER — rodapé do site
  ============================================================

  O QUE FAZ:
  Renderiza o rodapé da loja em duas faixas: a superior com blocks
  configuráveis (marca, menu, texto e newsletter) e a inferior com
  seletor de localização, ícones de pagamento, redes sociais e o
  copyright/crédito.

  ONDE É USADA:
  No layout (layout/theme.liquid), como footer presente em todas
  as páginas. É uma section de grupo/footer do tema.

  PRINCIPAIS PARTES:
  - footer__top: loop de section.blocks (case block.type) montando
    cada bloco — 'brand' (logo ou nome + texto), 'menu' (heading +
    link_list), 'text' (heading + richtext) e 'newsletter' (heading
    + snippet 'newsletter-form').
  - footer__bottom: seletor de localização (snippet
    'localization-form'), ícones de pagamento gerados de
    shop.enabled_payment_types, redes sociais (Instagram/Facebook/
    LinkedIn a partir dos settings globais social_*_link) e o
    copyright com o crédito da base (link lecdt.com).

  OBSERVAÇÕES:
  - Ícones de pagamento saem automaticamente das formas de
    pagamento habilitadas na loja (payment_type_svg_tag).
  - Toggles no schema: show_social, show_payment_icons e
    enable_localization.
  - Links de redes sociais vêm dos settings globais do tema
    (settings.social_*_link), não do schema desta section.
  - Ícones de redes vêm do snippet 'icon'.
{%- endcomment -%}
{%- liquid
  assign footer_brand_configured = false
  for block in section.blocks
    if block.type == 'brand'
      assign footer_brand_configured = true
      break
    endif
  endfor
  assign footer_quote_page = pages['pedir-orcamento']
  assign footer_about_page = pages['sobre-a-m3d']
  assign footer_contact_page = pages['contact']
  if footer_contact_page == blank
    assign footer_contact_page = pages['contato']
  endif
-%}
<footer class="footer" data-section-id="{{ section.id }}">
  <div class="footer__top page-width">
    {%- unless footer_brand_configured -%}
      <div class="footer__block footer__block--brand">
        <a class="footer__brand-logo" href="{{ routes.root_url }}"><img class="footer__logo" src="{{ 'logo-m3d-horizontal-negativo.svg' | asset_url }}" width="145" height="33" alt="{{ shop.name | escape }}" loading="lazy"></a>
        <img class="footer__slogan" src="{{ 'slogan-make-it-real-negativo.svg' | asset_url }}" width="296" height="30" alt="Make it real." loading="lazy">
      </div>
    {%- endunless -%}
    <nav class="footer__block" aria-label="{{ 'm3d_footer.explore' | t }}">
      <h2 class="footer__heading">{{ 'm3d_footer.explore' | t }}</h2>
      <ul class="footer__menu" role="list">
        <li><a class="footer__link" href="{{ routes.all_products_collection_url }}">{{ 'sections.collection_banner.products' | t }}</a></li>
        {%- if footer_quote_page != blank -%}<li><a class="footer__link" href="{{ footer_quote_page.url }}?view=m3d-quote">{{ footer_quote_page.title | escape }}</a></li>{%- endif -%}
        {%- if footer_about_page != blank -%}<li><a class="footer__link" href="{{ footer_about_page.url }}">{{ footer_about_page.title | escape }}</a></li>{%- endif -%}
      </ul>
    </nav>
    {%- capture footer_help_links -%}
      {%- if footer_contact_page != blank -%}<li><a class="footer__link" href="{{ footer_contact_page.url }}">{{ 'm3d_footer.contact' | t }}</a></li>{%- endif -%}
      {%- if shop.shipping_policy.body != blank -%}<li><a class="footer__link" href="{{ shop.shipping_policy.url }}">{{ 'm3d_footer.shipping' | t }}</a></li>{%- endif -%}
      {%- if shop.refund_policy.body != blank -%}<li><a class="footer__link" href="{{ shop.refund_policy.url }}">{{ 'm3d_footer.refunds' | t }}</a></li>{%- endif -%}
      {%- if shop.privacy_policy.body != blank -%}<li><a class="footer__link" href="{{ shop.privacy_policy.url }}">{{ 'm3d_footer.privacy' | t }}</a></li>{%- endif -%}
      {%- if shop.terms_of_service.body != blank -%}<li><a class="footer__link" href="{{ shop.terms_of_service.url }}">{{ 'm3d_footer.terms' | t }}</a></li>{%- endif -%}
    {%- endcapture -%}
    {%- if footer_help_links != blank -%}
      <nav class="footer__block" aria-label="{{ 'm3d_footer.help' | t }}">
        <h2 class="footer__heading">{{ 'm3d_footer.help' | t }}</h2>
        <ul class="footer__menu" role="list">{{ footer_help_links }}</ul>
      </nav>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'brand' -%}
          <div class="footer__block footer__block--brand" {{ block.shopify_attributes }}>
            {%- if block.settings.logo != blank -%}
              {{
                block.settings.logo
                | image_url: width: 400
                | image_tag:
                  class: 'footer__logo',
                  widths: '150, 300, 400',
                  width: 150,
                  height: 150 | divided_by: block.settings.logo.aspect_ratio,
                  alt: shop.name | escape
              }}
            {%- else -%}
              <a class="footer__brand-logo" href="{{ routes.root_url }}"><img class="footer__logo" src="{{ 'logo-m3d-horizontal-negativo.svg' | asset_url }}" width="145" height="33" alt="{{ shop.name | escape }}" loading="lazy"></a>
            {%- endif -%}
            <img class="footer__slogan" src="{{ 'slogan-make-it-real-negativo.svg' | asset_url }}" width="296" height="30" alt="Make it real." loading="lazy">
            {%- if block.settings.text != blank -%}
              <div class="footer__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>

        {%- when 'menu' -%}
          <div class="footer__block footer__block--menu" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="footer__menu" role="list">
                {%- for link in block.settings.menu.links -%}
                  {%- if link.url != blank and link.url != routes.root_url and link.url != '#' -%}<li><a href="{{ link.url }}" class="footer__link">{{ link.title | escape }}</a></li>{%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

        {%- when 'text' -%}
          <div class="footer__block footer__block--text" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="footer__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>

        {%- when 'newsletter' -%}
          <div class="footer__block footer__block--newsletter" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {% render 'newsletter-form', block: block %}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="footer__bottom page-width">
    <div class="footer__bottom-left">
      {%- if section.settings.enable_localization -%}
        {% render 'localization-form',
          section_id: section.id,
          show_country: true,
          show_language: true
        %}
      {%- endif -%}
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payment" role="list" aria-label="{{ 'sections.footer.payment' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="footer__bottom-right">
      {%- if section.settings.show_social -%}
        <ul class="footer__social" role="list">
          {%- if settings.social_instagram_link != blank -%}
            <li><a href="{{ settings.social_instagram_link }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', name: 'instagram' %}</a></li>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <li><a href="{{ settings.social_facebook_link }}" aria-label="Facebook" rel="noopener" target="_blank">{% render 'icon', name: 'facebook' %}</a></li>
          {%- endif -%}
          {%- if settings.social_linkedin_link != blank -%}
            <li><a href="{{ settings.social_linkedin_link }}" aria-label="LinkedIn" rel="noopener" target="_blank">{% render 'icon', name: 'linkedin' %}</a></li>
          {%- endif -%}
        </ul>
      {%- endif -%}
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'sections.footer.rights' | t }}

      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--m3d-color-surface-inverse);
    color: var(--m3d-color-text-inverse);
    margin-top: var(--spacing-sections);
  }
  .footer__top {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
    padding-top: 48px;
    padding-bottom: 48px;
  }
  .footer__logo { display: block; height: auto; margin-bottom: 16px; }
  .footer__brand-name { font-family: var(--font-heading-family); font-size: var(--m3d-text-xl); margin-bottom: 12px; }
  .footer__heading { font-size: var(--m3d-text-lg); margin-bottom: 16px; }
  .footer__menu { list-style: none; margin: 0; padding: 0; }
  .footer__link { display: inline-block; padding: 6px 0; color: inherit; text-decoration: none; font-size: var(--m3d-text-sm); }
  .footer__link:hover { text-decoration: underline; }
  .footer__text { font-size: var(--m3d-text-sm); line-height: 1.6; }
  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 24px;
    padding-bottom: 24px;
    border-top: 1px solid var(--m3d-gray-600);
  }
  .footer__bottom-left,
  .footer__bottom-right { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .footer__payment { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  .footer__payment-icon { width: 38px; height: 24px; }
  .footer__social { display: flex; gap: 12px; list-style: none; margin: 0; padding: 0; }
  .footer__social a { color: inherit; display: inline-flex; }
  .footer__copyright { font-size: var(--m3d-text-xs); }
  .footer__credit a { color: inherit; text-decoration: underline; }
  .footer__credit a:hover { color: var(--m3d-color-text-inverse); }

  @media screen and (max-width: 1000px) {
    .footer__bottom { flex-direction: column; align-items: flex-start; }
  }

  .footer{font-family:var(--m3d-font-family);font-weight:var(--m3d-weight-regular)}
  .footer__top{grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:var(--m3d-space-7);padding-block:var(--m3d-space-8)}
  .footer__block{min-width:0;overflow-wrap:anywhere}
  .footer__brand-logo{display:inline-flex;padding:calc(var(--m3d-logo-h-height) * var(--m3d-logo-h-clearspace-ratio));margin-bottom:var(--m3d-space-4)}
  .footer__logo{display:block;width:auto;height:var(--m3d-logo-h-height);max-width:100%;margin:0}
  .footer__slogan{display:block;width:220px;max-width:100%;height:auto;margin:0 0 var(--m3d-space-5)}
  .footer__heading{font-weight:var(--m3d-weight-bold)}
  .footer__link{display:inline-flex;align-items:center;min-height:44px;padding-block:var(--m3d-space-2)}
  .footer__social a{display:inline-flex;align-items:center;justify-content:center;min-width:44px;min-height:44px}
  .footer :focus-visible{outline:var(--m3d-focus-width) solid var(--m3d-focus-color-inverse);outline-offset:var(--m3d-focus-offset)}
  .footer .localization-form__select{color:var(--m3d-color-text-inverse);background:var(--m3d-color-surface-inverse)}
  @media(max-width:600px){.footer__top{gap:var(--m3d-space-6);padding-block:var(--m3d-space-7)}.footer__brand-logo{padding:calc(var(--m3d-logo-h-height-mobile) * var(--m3d-logo-h-clearspace-ratio))}.footer__logo{height:var(--m3d-logo-h-height-mobile)}}
</style>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "brand",
      "name": "t:sections.footer.blocks.brand.name",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "t:sections.footer.blocks.brand.settings.logo.label" },
        { "type": "richtext", "id": "text", "label": "t:sections.footer.blocks.brand.settings.text.label" }
      ]
    },
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        { "type": "text", "id": "heading", "default": "Quick links", "label": "t:sections.footer.blocks.menu.settings.heading.label" },
        { "type": "link_list", "id": "menu", "default": "footer", "label": "t:sections.footer.blocks.menu.settings.menu.label" }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.footer.blocks.text.settings.heading.label" },
        { "type": "richtext", "id": "text", "label": "t:sections.footer.blocks.text.settings.text.label" }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "default": "Subscribe to our newsletter", "label": "t:sections.footer.blocks.newsletter.settings.heading.label" }
      ]
    }
  ],
  "settings": [
    { "type": "checkbox", "id": "show_social", "default": true, "label": "t:sections.footer.settings.show_social.label" },
    { "type": "checkbox", "id": "show_payment_icons", "default": true, "label": "t:sections.footer.settings.show_payment_icons.label" },
    { "type": "checkbox", "id": "enable_localization", "default": true, "label": "t:sections.footer.settings.enable_localization.label" }
  ],
  "presets": [
    {
      "name": "t:sections.footer.name",
      "blocks": [
        { "type": "brand" },
        { "type": "menu" },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
